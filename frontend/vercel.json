{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/charts.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/apple-charts",
      "destination": "/api/charts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
