{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip npm ci",
  "buildCommand": "npm run test:ai && node scripts/prepare-ai-runtime.mjs && npm run build:dual",
  "outputDirectory": "dist-dual",
  "headers": [
    { "source": "/intelligence/:name.bin", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
    { "source": "/intelligence/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/catalogue/:name.bin", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
    { "source": "/service-config.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/firebase-config.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/analyze-audio.js": {
      "maxDuration": 60,
      "includeFiles": "server/models/**",
      "excludeFiles": "{node_modules/onnxruntime-node/bin/**/{darwin,win32,arm64}/**,node_modules/onnxruntime-web/**}"
    },
    "api/charts.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/apple-charts",
      "destination": "/api/charts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
